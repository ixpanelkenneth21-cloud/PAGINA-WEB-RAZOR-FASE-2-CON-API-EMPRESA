@page "/cliente"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>Clientes</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Listado de Clientes</h2>
        <button class="btn btn-primary" @onclick="AbrirNuevo">Nuevo</button>
    </div>

    @if (!string.IsNullOrEmpty(error))
    {
        <div class="alert alert-danger">@error</div>
    }

    @if (clientes is null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary"></div>
        </div>
    }
    else if (clientes.Count == 0)
    {
        <div class="alert alert-info">No hay clientes registrados.</div>
    }
    else
    {
        <div class="table-responsive shadow-sm rounded">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>CUI</th>
                        <th>NIT</th>
                        <th>Nombres</th>
                        <th>Apellidos</th>
                        <th>Dirección</th>
                        <th>Teléfono</th>
                        <th>F. Nacimiento</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Pagina)
                    {
                        <tr>
                            <td>@c.cui</td>
                            <td>@c.nit</td>
                            <td>@c.nombres</td>
                            <td>@c.apellidos</td>
                            <td>@c.direccion</td>
                            <td>@c.telefono</td>
                            <td>@c.fecha_nacimiento?.ToString("dd/MM/yyyy")</td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-warning" @onclick="() => AbrirEditar(c)">Editar</button>
                                    <button class="btn btn-danger" @onclick="() => Eliminar(c)">Eliminar</button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <nav class="d-flex justify-content-between align-items-center mt-3">
            <span class="text-muted small">Página @paginaActual de @TotalPaginas (@clientes.Count registros)</span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(paginaActual == 1 ? "disabled" : "")">
                    <button class="page-link" @onclick="() => IrAPagina(paginaActual - 1)">Anterior</button>
                </li>
                @for (var i = 1; i <= TotalPaginas; i++)
                {
                    var p = i;
                    <li class="page-item @(paginaActual == p ? "active" : "")">
                        <button class="page-link" @onclick="() => IrAPagina(p)">@p</button>
                    </li>
                }
                <li class="page-item @(paginaActual == TotalPaginas ? "disabled" : "")">
                    <button class="page-link" @onclick="() => IrAPagina(paginaActual + 1)">Siguiente</button>
                </li>
            </ul>
        </nav>
    }
</div>

@if (mostrarModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title">@titulo</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="Cerrar"></button>
                </div>
                <EditForm Model="form" OnValidSubmit="Guardar">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">CUI</label>
                                <InputText class="form-control form-control-sm" @bind-Value="form.cui" />
                                <ValidationMessage For="() => form.cui" class="text-danger small" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">NIT</label>
                                <InputText class="form-control form-control-sm" @bind-Value="form.nit" />
                                <ValidationMessage For="() => form.nit" class="text-danger small" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Nombres</label>
                                <InputText class="form-control form-control-sm" @bind-Value="form.nombres" />
                                <ValidationMessage For="() => form.nombres" class="text-danger small" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Apellidos</label>
                                <InputText class="form-control form-control-sm" @bind-Value="form.apellidos" />
                                <ValidationMessage For="() => form.apellidos" class="text-danger small" />
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-bold">Dirección</label>
                                <InputText class="form-control form-control-sm" @bind-Value="form.direccion" />
                                <ValidationMessage For="() => form.direccion" class="text-danger small" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Teléfono</label>
                                <InputText class="form-control form-control-sm" @bind-Value="form.telefono" />
                                <ValidationMessage For="() => form.telefono" class="text-danger small" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">F. Nacimiento</label>
                                <InputDate class="form-control form-control-sm" @bind-Value="form.fecha_nacimiento" />
                                <ValidationMessage For="() => form.fecha_nacimiento" class="text-danger small" />
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-secondary btn-sm" @onclick="Cerrar" disabled="@guardando">Cancelar</button>
                        <button type="submit" class="btn btn-success btn-sm" disabled="@guardando">Guardar</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    private const int TamanoPagina = 5;

    private List<ClienteDto>? clientes;
    private ClienteDto form = new();
    private bool mostrarModal;
    private bool guardando;
    private string titulo = "";
    private string? error;
    private int paginaActual = 1;

    private int TotalPaginas =>
        Math.Max(1, (int)Math.Ceiling((clientes?.Count ?? 0) / (double)TamanoPagina));

    private IEnumerable<ClienteDto> Pagina =>
        (clientes ?? new()).Skip((paginaActual - 1) * TamanoPagina).Take(TamanoPagina);

    protected override async Task OnInitializedAsync() => await Cargar();

    private async Task Cargar()
    {
        try
        {
            clientes = await Http.GetFromJsonAsync<List<ClienteDto>>("api/Clientes") ?? new();
            if (paginaActual > TotalPaginas) paginaActual = TotalPaginas;
        }
        catch (Exception ex)
        {
            clientes ??= new();
            error = $"No se pudo cargar la lista: {ex.Message}";
        }
    }

    private void IrAPagina(int p)
    {
        if (p >= 1 && p <= TotalPaginas) paginaActual = p;
    }

    private void AbrirNuevo()
    {
        titulo = "Nuevo Cliente";
        form = new ClienteDto { fecha_nacimiento = DateTime.Today.AddYears(-20) };
        mostrarModal = true;
    }

    private void AbrirEditar(ClienteDto c)
    {
        titulo = "Editar Cliente";
        form = new ClienteDto
        {
            Id_cliente = c.Id_cliente,
            cui = c.cui,
            nit = c.nit,
            nombres = c.nombres,
            apellidos = c.apellidos,
            direccion = c.direccion,
            telefono = c.telefono,
            fecha_nacimiento = c.fecha_nacimiento
        };
        mostrarModal = true;
    }

    private void Cerrar()
    {
        if (!guardando) mostrarModal = false;
    }

    private async Task Guardar()
    {
        guardando = true;
        error = null;
        try
        {
            var resp = form.Id_cliente == 0
                ? await Http.PostAsJsonAsync("api/Clientes", form)
                : await Http.PutAsJsonAsync($"api/Clientes/{form.Id_cliente}", form);

            if (resp.IsSuccessStatusCode)
            {
                mostrarModal = false;
                await Cargar();
            }
            else
            {
                error = $"Error al guardar ({(int)resp.StatusCode}).";
            }
        }
        catch (Exception ex)
        {
            error = $"Error al guardar: {ex.Message}";
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task Eliminar(ClienteDto c)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"¿Eliminar a {c.nombres} {c.apellidos}?")) return;

        error = null;
        try
        {
            var resp = await Http.DeleteAsync($"api/Clientes/{c.Id_cliente}");
            if (resp.IsSuccessStatusCode)
                await Cargar();
            else
                error = $"Error al eliminar ({(int)resp.StatusCode}).";
        }
        catch (Exception ex)
        {
            error = $"Error al eliminar: {ex.Message}";
        }
    }

    public class ClienteDto
    {
        public int Id_cliente { get; set; }

        [Required(ErrorMessage = "El CUI es obligatorio.")]
        public string? cui { get; set; }

        [Required(ErrorMessage = "El NIT es obligatorio.")]
        [StringLength(15, ErrorMessage = "Máximo 15 caracteres.")]
        public string? nit { get; set; }

        [Required(ErrorMessage = "Los nombres son obligatorios.")]
        [StringLength(100, ErrorMessage = "Máximo 100 caracteres.")]
        public string? nombres { get; set; }

        [Required(ErrorMessage = "Los apellidos son obligatorios.")]
        [StringLength(100, ErrorMessage = "Máximo 100 caracteres.")]
        public string? apellidos { get; set; }

        [Required(ErrorMessage = "La dirección es obligatoria.")]
        [StringLength(200, ErrorMessage = "Máximo 200 caracteres.")]
        public string? direccion { get; set; }

        [Required(ErrorMessage = "El teléfono es obligatorio.")]
        [RegularExpression(@"^\d{8}$", ErrorMessage = "El teléfono debe tener 8 dígitos.")]
        public string? telefono { get; set; }

        [Required(ErrorMessage = "La fecha de nacimiento es obligatoria.")]
        public DateTime? fecha_nacimiento { get; set; }
    }
}